//VECTOR CLASS

public class Vector {
    private double x;
    private double y;
    private double z;

    // Default constructor
    Vector() {
        x = 0;
        y = 0;
        z = 0;
    }

    // Parameterized constructor
    Vector(double x, double y, double z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }

    // Copy constructor
    Vector(Vector v) {
        this.x = v.x;
        this.y = v.y;
        this.z = v.z;
    }

    // Getters
    public double getX() {
        return x;
    }

    public double getY() {
        return y;
    }

    public double getZ() {
        return z;
    }

    // Setters
    public void setX(double x) {
        this.x = x;
    }

    public void setY(double y) {
        this.y = y;
    }

    public void setZ(double z) {
        this.z = z;
    }

    // Set XYZ
//    public void setXYZ(double x, double y, double z) {
//        this.x = x;
//        this.y = y;
//        this.z = z;
//    }

    // Vector addition
    public Vector add(Vector v) {
        return new Vector(
                this.x + v.x,
                this.y + v.y,
                this.z + v.z
        );
    }
    //overload
    public Vector add(double x, double y, double z) {
        return new Vector(
                this.x + x,
                this.y + y,
                this.z + z
        );
    }

    // Vector subtraction
    public Vector subtract(Vector v) {
        return new Vector(
                this.x - v.x,
                this.y - v.y,
                this.z - v.z
        );
    }

    // Display
    public void display() {

        System.out.println("(" + x + ", " + y + ", " + z + ")");
    }

    // toString
    @Override
    public String toString() {

        return "(" + x + ", " + y + ", " + z + ")";
    }

}


//POINT.JAVA

public class Point {
    private double x;
    private double y;

    // Default constructor
    Point() {
        x = 0;
        y = 0;
    }

    // Parameterized constructor
    Point(double x, double y) {
        this.x = x;
        this.y = y;
    }

    // Copy constructor
    Point(Point p) {
        this.x = p.x;
        this.y = p.y;
    }

    // Getters
    public double getX() {
        return x;
    }

    public double getY() {
        return y;
    }

    // Setters
    public void setX(double x) {
        this.x = x;
    }

    public void setY(double y) {
        this.y = y;
    }

    // Set both X and Y
//    public void setXY(double x, double y) {
//        this.x = x;
//        this.y = y;
//    }
    // p2 - p1
    public Vector subtract(Point p) {
        return new Vector(
                this.x - p.x,
                this.y - p.y,
                0
        );
    }

    // Display
    public void display() {
        System.out.println("(" + x + ", " + y + ")");
    }

    // toString
    @Override
    public String toString() {
        return "(" + x + ", " + y + ")";
    }

