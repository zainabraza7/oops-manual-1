public class main1 {

    public static void main(String[] args) {


        Player player = new Player("Sara", 2, 6);

        // Sara ke dono dice roll honge.
        // Dono dice ke results print honge aur total calculate hoga.
        player.roll();

        // getTotal() current total return karega.
        // Ye line initial total screen par print karegi.
        System.out.println("Initial total: " + player.getTotal());

        // index 1 ka matlab doosra dice, kyun ke array index 0 se shuru hota hai.
        // Sirf doosra dice dobara roll hoga.
        // Pehle dice ka purana result same rahega.
        player.rollAgain(1);

        // Dobara roll ke baad updated total print hoga.
        System.out.println("New total: " + player.getTotal());

        String info = player.toString();
        System.out.println(info);
    }

}
