public class Dice {
    // Attribute: ye store karega ke is dice ki kitni sides hain.
    // Example: agar sides = 6 hai, toh dice par 1 se 6 tak numbers aa sakte hain.
    private int sides;

    // Constructor: jab hum new Dice(6) likhenge, ye constructor chalega.
    // Parameter 'sides' mein hum dice ki sides ki quantity bhejte hain.
    public Dice(int sides) {


        this.sides = sides;
    }

    // Ye method dice ko roll karta hai aur ek random integer return karta hai.
    // Return type int hai, kyun ke humein whole number chahiye.
    public int roll() {

        // Math.random() 0.0 se lekar 1.0 se chhoti value deta hai.
        // Math.random() * sides se value 0 se sides se chhoti range mein aati hai.
        // (int) decimal part hata kar integer banata hai.
        // + 1 karne se result 1 se sides tak ho jata hai.
        // Example: sides = 6 ho, toh result 1, 2, 3, 4, 5, ya 6 ho sakta hai.
        return (int) (Math.random() * sides) + 1;
    }

    // Ye method dice ki sides ki quantity return karta hai.
    // Example: agar sides = 6 hai, toh getSides() 6 return karega.
    public int getSides() {
        return sides;
    }
    // Har Dice object ki information String mein return karta hai.
    @Override
    public String toString() {
        return "Sides: " + this.sides;
    }
}
