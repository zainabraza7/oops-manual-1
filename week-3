public class triangle {
    private double sideA;
    private double sideB;
    private double sideC;

    private static int count = 0;
    // 1. Default constructor

    public triangle() {
        sideA = 1.0;
        sideB = 1.0;
        sideC = 1.0;
        count++;

    }

    // 2. One parameter constructor

    public triangle(double side) {
        sideA = side;
        sideB = side;
        sideC = side;
        count++;
    }
    // 3. Two parameter constructor

    public triangle(double x, double y) {
        sideA = x;
        sideB = x;
        sideC = y;
        count++;
    }
    // 4. Three parameter constructor

    public triangle(double x, double y, double z) {
        sideA = x;
        sideB = y;
        sideC = z;
        count++;

    }
    // 5. Copy constructor

    public triangle(triangle other) {
        sideA = other.sideA;
        sideB = other.sideB;
        sideC = other.sideC;
        count++;

    }

    //object count
    public static int  objectCount() {
        return count;
    }

    public double perimeter() {
        return sideA + sideB + sideC;
    }
/*use pythagoras for rightangle(90) Agar sabse badi side ka square = doosri do sides ke
 squares ka jod, to wo triangle right-angled hai.
 */
    public boolean isRightAngled() {
        double largest;
        double other2;
        double other3;

        if (sideA >= sideB && sideA >= sideC) {
            largest = sideA;
            other2 = sideB;
            other3 = sideC;
        } else if (sideB >= sideA && sideB >= sideC) {
            largest = sideB;
            other2 = sideA;
            other3 = sideC;
        } else {
            largest = sideC;
            other2 = sideA;
            other3 = sideB;
        }
        // check karo: chote do ka square-sum == bade ka square?
        double difference = Math.abs((other2*other2 + other3*other3) - (largest*largest));



        return difference < 0.0001;   // bilkul 0 ho ya bahut kareeb ho
    }

    // 9. toString
    @Override
    public String toString() {
        return "Triangle: sideA = " + sideA + ", sideB = " + sideB + ", sideC = " + sideC;

    }

}


//MAIN CLASS

public class main1 {
    public static void main(String[] args) {

        triangle t1 = new triangle();

        triangle t2 = new triangle(5);

        triangle t3 = new triangle(5, 8);

        triangle t4 = new triangle(3, 4, 5);

        triangle t5 = new triangle(t4);

        System.out.println(t1);
        System.out.println(t2);
        System.out.println(t3);
        System.out.println(t4);
        System.out.println(t5);

        System.out.println("Perimeter of t4: " + t4.perimeter());

        System.out.println("t4 is right angled: "
                + t4.isRightAngled());

        System.out.println("Total objects: "
                + triangle.objectCount());
    }
}





