import java.nio.charset.StandardCharsets;
import java.util.Arrays;
public class encoding {
    public static void main(String[] args) {

        String text = "My name is Zainab";
//bytes ko array mein store kya
        byte[] data = text.getBytes(StandardCharsets.UTF_8); //text ko UTF-8 bytes mein encode kiya.

        System.out.println(Arrays.toString(data)); //array ke bytes print kiye
    }
}
public static void main(String[] args) {

    String text = "My name is Zainab";

    // Convert string into UTF-8 bytes
    byte[] data = text.getBytes(StandardCharsets.UTF_8);

    // Print encoded bytes
    System.out.println(Arrays.toString(data));
}
