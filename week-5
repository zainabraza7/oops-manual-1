//LINE CLASS

public class Line {
    //composition
    private Point start;
    private Point end;

    //default const
    Line(){
        start=new Point();
        end=new Point();
    }
    //parametrized const
    Line(Point start,Point end){
        this.start=new Point(start);
        this.end=new Point(end);
    }
    //copy const
    Line(Line l){
        this.start=new Point(l.start);
        this.end=new Point(l.end);
    }
    //getters
    public Point getStart(){

        return new Point(start);
    }
    //setters
    public void setStart(Point start){

        this.start=new Point(start);
    }
    public void setEnd(Point end){

        this.end=new Point(end);
    }
    //calculate length
    public double length(){
        int xDifference =end.getX() -start.getX();  //x2-x1
        int yDifference=end.getY() - start.getY();

        return Math.sqrt(
                xDifference * xDifference+ //squareroot(x2-x1)square
                yDifference * yDifference
        );
    }
    // Display Line
    public void display() {

        System.out.print("Start Point: ");
        start.display();

        System.out.print("End Point: ");
        end.display();

        System.out.println("Length: " + length());
    }



}

//MAIN.JAVA
public class Main {
    public static void main(String[] args) {

        //creating two points
        Point p1=new Point(2,3);
        Point p2=new Point(7,8);

        //creating line using two points
        Line line1=new Line(p1,p2);

        //display line
        line1.display();
        System.out.println();

        //copy constructor
        Line line2=new Line(line1);
        System.out.println("Copied line: ");
        line2.display();



    }
}

//POINT CLASS

public class Point {
    private int x;
    private int y;
    //default const
    Point(){
        x=0;
        y=0;
    }

    //parametrized const
    Point(int x,int y){
        this.x=x;
        this.y=y;
    }
    //copy const
    Point(Point p){
        this.x=p.x;
        this.y=p.y;
    }
    //getters


    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }
    //setters

    public void setY(int y) {
        this.y = y;
    }

    public void setX(int x) {
        this.x = x;
    }
    // Display
    public void display() {
        System.out.println("(" + x + ", " + y + ")");
    }

}
