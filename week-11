import java.util.Arrays;

public class PointArray implements Cloneable {

    private Point[] points;

    // Constructor
    public PointArray(Point[] points) {

        this.points = points;
    }

    // Get Point
    public Point getPoint(int index) {

        return this.points[index];
    }

    // Shallow copy
    @Override
    public PointArray clone() throws CloneNotSupportedException {

        return (PointArray) super.clone(); //super parent class hai
    }

    // Deep copy
    public PointArray deepCopy() throws CloneNotSupportedException {

        PointArray copy = (PointArray) super.clone();

/* super.clone() copy banata hai, new Point[] naya array banata hai, aur new Point(...)
 har Point ka naya object banata hai
 */

        // Create a new Point array
        copy.points = new Point[this.points.length];

        // Create new Point objects
        for (int i = 0; i < this.points.length; i++) {

            copy.points[i] = new Point(this.points[i]);
        }

        return copy;


    }

